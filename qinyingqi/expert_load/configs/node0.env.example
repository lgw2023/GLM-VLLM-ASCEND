# Node-local settings. Copy to node.env on node0 and keep it out of Git.
NODE_RANK=0
LOCAL_IP=REPLACE_ME
PEER_IP=REPLACE_ME
LOCAL_NIC=REPLACE_ME
AUTHORIZED_NPU_IDS=0,1,2,3,4,5,6,7
NPU_USE_CONFIRMED=NO

# Compute these hashes before the final preflight and before stopping keep-alive.
KEEPALIVE_STOP_SCRIPT=/data/node0_disk1/Public/npu_stop.sh
KEEPALIVE_START_SCRIPT=/data/node0_disk1/Public/npu_keep_alive.sh
KEEPALIVE_STOP_SHA256=REPLACE_WITH_PREFLIGHT_SHA256
KEEPALIVE_START_SHA256=REPLACE_WITH_PREFLIGHT_SHA256

MODEL_HOST_PATH=/data/node0_disk2/glm52-study/models/GLM-5.2-w8a8
RUN_HOST_ROOT=/data/node0_disk2/glm52-study/runs
# Safety-critical lease/recovery state must be on this node's local disk.
LOCAL_STATE_ROOT=/data/node0_disk2/glm52-study/local-state
