# Node-local settings. Copy to node.env on node1 and keep it out of Git.
NODE_RANK=1
LOCAL_IP=REPLACE_ME
PEER_IP=REPLACE_ME
LOCAL_NIC=REPLACE_ME
AUTHORIZED_NPU_IDS=0,1,2,3,4,5,6,7

# First-stage workflow requires the shared, manifest-validated node0 model path.
MODEL_HOST_PATH=/data/node0_disk2/glm52-study/models/GLM-5.2-w8a8
RUN_HOST_ROOT=/data/node0_disk2/glm52-study/runs
# Container ownership metadata for this project stays on the node-local disk.
LOCAL_STATE_ROOT=/data/disk2/glm52-study/local-state
