# Copy this file to configs/node3.env on Node3 (7.150.15.14), then edit
# MODEL_HOST_PATH if the checkpoint is stored elsewhere.

# The v0.22.1rc1 base is already used by deepseek_expert_load on Node3, so the
# derived image can normally be built without another registry pull.
BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.22.1rc1
IMAGE_REF=glm51-expert-capture:v0.22.1rc1-w4a8-v2
CAPTURE_PATCH_ID=glm51-w4a8-logical-topk-v2
EXPECTED_VLLM_PACKAGE_VERSION=0.22.1
EXPECTED_VLLM_ASCEND_PACKAGE_VERSION=0.22.1rc1

# GLM-5.1 W8A8 is not a single-node 8-card A2 profile. Use the W4A8 ModelSlim
# checkpoint for this Node3 baseline.
MODEL_REPO_ID=Eco-Tech/GLM-5.1-w4a8
MODEL_HOST_PATH=/data/disk1/Public/GLM-5.1-w4a8
REQUIRED_EXPERT_QUANTIZATION=w4a8
TARGET_SOC=ASCEND910B1

# Reuse the benchmark data already prepared for the GLM-5.2 experiment.
BENCHMARK_DATA_ROOT=/data/node0_disk2/glm52-study/runs/benchmark-data
RUN_ROOT=/data/disk2/glm51-expert-load/runs

# Use these only after all eight Node3 NPUs have been allocated to this run.
HOST_NPU_IDS=0,1,2,3,4,5,6,7

SERVED_MODEL_NAME=glm-5.1-w4a8
CONTAINER_PREFIX=glm51-w4a8-expert
API_HOST=127.0.0.1
API_PORT=7200

# Correctness-first settings for a one-record environment check.
MAX_MODEL_LEN=4096
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.95
WAIT_TIMEOUT_SECONDS=7200
STOP_TIMEOUT_SECONDS=180
BENCHMARK_MAX_TOKENS=16
