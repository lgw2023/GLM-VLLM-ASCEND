# Copy to configs/node0.env on Node0 and edit the values below.

IMAGE_REF=quay.io/ascend/vllm-ascend:v0.22.1rc1
MODEL_HOST_PATH=/data/node0_disk1/Public/DeepSeek-V4-Flash
TARGET_SOC=ASCEND910B1
REQUIRED_EXPERT_QUANTIZATION=w4a8

# Use the existing prepared benchmark inputs. No dataset is downloaded by this project.
BENCHMARK_DATA_ROOT=/data/node0_disk2/glm52-study/runs/benchmark-data
RUN_ROOT=/data/node0_disk2/deepseek-expert-load/runs

# Required: four NPU IDs allocated to you by the administrator, for example 0,1,2,3.
HOST_NPU_IDS=

SERVED_MODEL_NAME=deepseek-v4-flash
CONTAINER_PREFIX=deepseek-v4-expert
API_HOST=127.0.0.1
API_PORT=7100
MAX_MODEL_LEN=8192
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.90
WAIT_TIMEOUT_SECONDS=3600
STOP_TIMEOUT_SECONDS=120
BENCHMARK_MAX_TOKENS=16
BENCHMARK_MAX_REQUESTS=0
