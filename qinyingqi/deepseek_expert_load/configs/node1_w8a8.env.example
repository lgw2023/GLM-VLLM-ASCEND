# Copy to configs/node1_w8a8.env on 7.150.15.14 and verify every path.

# Build this image with scripts/07_build_capture_image.sh before launching.
# It captures logical top-k IDs through Ascend's FusedMoE capturer.
IMAGE_REF=deepseek-v4-expert-capture:v0.22.1rc1-w8a8-v2
CAPTURE_PATCH_ID=deepseek-v4-w8a8-logical-topk-v2
EXPECTED_VLLM_PACKAGE_VERSION=0.22.1
EXPECTED_VLLM_ASCEND_PACKAGE_VERSION=0.22.1rc1
MODEL_HOST_PATH=/data/node0_disk1/Public/DeepSeek-V4-Flash-w8a8-mtp
TARGET_SOC=ASCEND910B1
REQUIRED_EXPERT_QUANTIZATION=w8a8

# These are network mounts on Node1. Results stay on Node1's local NVMe.
BENCHMARK_DATA_ROOT=/data/node0_disk2/glm52-study/runs/benchmark-data
RUN_ROOT=/data/disk2/deepseek-expert-load-w8a8/runs

# Use only after the administrator has allocated all eight NPUs to this run.
HOST_NPU_IDS=0,1,2,3,4,5,6,7

SERVED_MODEL_NAME=deepseek-v4-flash-w8a8
CONTAINER_PREFIX=deepseek-v4-w8a8-expert
API_HOST=127.0.0.1
API_PORT=7100
MAX_MODEL_LEN=8192
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.90
WAIT_TIMEOUT_SECONDS=7200
STOP_TIMEOUT_SECONDS=180
BENCHMARK_MAX_TOKENS=16
BENCHMARK_MAX_REQUESTS=0
